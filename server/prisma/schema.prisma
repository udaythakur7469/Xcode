// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// User Model
// Represents a user of the application.
// =========================================================

model User {
  // Unique identifier for the user.
  id Int @id @default(autoincrement())

  // Optional name of the user.
  name String?

  // Unique email address for the user.
  email String @unique

  // User's password (should be stored hashed).
  password String?

  // Optional profile picture with a default image.
  picture String? @default("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTM3FwFWSj9qohGE7FhrwJ-PlcK4-tLdWSlGg&s")

  // User's token
  refreshToken String?

  provider   String?
  providerId String?

  magicLinkToken  String?
  magicLinkExpiry DateTime?

  passwordResetToken  String?
  passwordResetExpiry DateTime?

  description String?

  institution String?

  links UserLink[]

  Interviews Interview[]

  Feedbacks Feedback[]

  Posts Post[]

  // Relations:
  // - One-to-many relation with solved problems.
  solvedProblems SolvedProblems[]

  // - One-to-many relation with submissions.
  submissions Submission[]

  // - One-to-many relation with problem reactions
  problemReactions UserProblemReactions[]

  postReactions PostReaction[]

  comments Comment[]

  commentReactions CommentReaction[]

  // - One-to-one relation with stats (optional).
  stats Stats?

  Chats Chat[]

  SharedChats SharedChat[]

  problemHelpStates ProblemHelpState[]

  stickyNotes StickyNote[]

  // Timestamp fields.
  lastLogin DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

// =========================================================
// SolvedProblems Model
// Represents an instance when a user solved a problem.
// =========================================================

model SolvedProblems {
  // Unique identifier for each solved problem record.
  id Int @id @default(autoincrement())

  // Relation: The user who solved the problem.
  user   User @relation(fields: [userId], references: [id])
  userId Int

  // Relation: The problem that was solved.
  problem   Problem @relation(fields: [problemId], references: [id])
  problemId Int

  // Timestamp for when the problem was solved.
  solvedAt DateTime @default(now())

  // Ensure each user can only have one record per problem
  @@unique([userId, problemId])
}

// =========================================================
// Stats Model
// Represents a user's statistics for solved problems.
// =========================================================

model Stats {
  // Unique identifier for the stats record.
  id Int @id @default(autoincrement())

  // Relation: Each stats record is linked to one user.
  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique // Unique to enforce a one-to-one relationship.

  // Statistical fields with default values.
  totalSolved  Int @default(0)
  easySolved   Int @default(0)
  mediumSolved Int @default(0)
  hardSolved   Int @default(0)
}

// =========================================================
// Problem Model
// Represents a coding problem in the system.
// =========================================================

model Problem {
  // Unique identifier for each problem.
  id Int @id @default(autoincrement())

  // Title of the problem.
  title String

  // Detailed description of the problem.
  description String

  constraints String[]

  // Difficulty level (uses the Difficulty enum).
  difficulty Difficulty

  // Array of tags associated with the problem.
  tags String[]

  // Status to check whether problem is solved or not
  solved Boolean @default(false)

  // Relations:
  // - One-to-many relation with solved problems.
  solvedProblems SolvedProblems[]

  // - One-to-many relation with examples.
  examples Example[]

  // - One-to-many relation with test cases.
  testCases TestCases[]

  hints Hints[]

  // - One-to-many relation with submissions.
  submissions Submission[]

  // - One-to-many relation with baseCodes.
  baseCodes BaseCode[]

  // - One-to-one relation with editorial
  editorial Editorial?

  // - One-to-many relation with user reactions
  userReactions UserProblemReactions[]

  postReactions PostReaction[]

  Posts Post[]

  // - One-to-one relation with problem statistics (optional).
  problemStats ProblemStats?

  problemHelpStates ProblemHelpState[]

  submissionRuntimes SubmissionRuntime[]

  // Timestamp for problem creation.
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Comment   Comment[]
}

// =========================================================
// Difficulty Enum
// Represents the allowed difficulty levels for problems.
// =========================================================

enum Difficulty {
  easy
  medium
  hard
}

// =========================================================
// Example Model
// Represents an example for a problem, including input, output, and explanation.
// =========================================================

model Example {
  // Unique identifier for each example.
  id Int @id @default(autoincrement())

  // Relation: The problem this example belongs to.
  problem   Problem @relation(fields: [problemId], references: [id])
  problemId Int

  // Example fields.
  input       String
  output      String
  explanation String
}

// =========================================================
// TestCases Model
// Represents test cases for a problem.
// =========================================================

model TestCases {
  // Unique identifier for each test case.
  id Int @id @default(autoincrement())

  // Relation: The problem this test case belongs to.
  problem   Problem @relation(fields: [problemId], references: [id])
  problemId Int

  // Test case details.
  userInput          String
  apiInput           String
  userExpectedOutput String
  apiExpectedOutput  String
}

// =========================================================
// ProblemStats Model
// Represents statistical data for a problem (one-to-one relation).
// =========================================================

model ProblemStats {
  // Unique identifier for the problem stats record.
  id Int @id @default(autoincrement())

  // Relation: The problem associated with these stats.
  problem   Problem @relation(fields: [problemId], references: [id])
  problemId Int     @unique // Unique to enforce one-to-one relationship.

  // Statistical fields for the problem.
  totalAttempts  Int   @default(0)
  totalSolved    Int   @default(0)
  acceptanceRate Float @default(0)
  // - One-to-many relation with hints.
}

model Hints {
  id Int @id @default(autoincrement()) // Unique identifier.

  problem   Problem @relation(fields: [problemId], references: [id])
  problemId Int // Associated problem.

  hint String // Hint for the problem.
}

model Editorial {
  id        Int     @id @default(autoincrement())
  problemId Int     @unique
  problem   Problem @relation(fields: [problemId], references: [id])

  videoUrl String?

  bruteForceTitle           String
  bruteForceIntuition       String
  bruteForceAlgorithm       String
  bruteForceCodeCpp         String
  bruteForceCodeJs          String
  bruteForceCodePython      String
  bruteForceCodeJava        String
  bruteForceTimeComplexity  String
  bruteForceSpaceComplexity String

  betterTitle           String
  betterIntuition       String
  betterAlgorithm       String
  betterCodeCpp         String
  betterCodeJs          String
  betterCodePython      String
  betterCodeJava        String
  betterTimeComplexity  String
  betterSpaceComplexity String

  optimalTitle           String
  optimalIntuition       String
  optimalAlgorithm       String
  optimalCodeCpp         String
  optimalCodeJs          String
  optimalCodePython      String
  optimalCodeJava        String
  optimalTimeComplexity  String
  optimalSpaceComplexity String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// Submission Model
// Represents a user's submission for a problem.
// =========================================================

model Submission {
  // Unique identifier for each submission.
  id Int @id @default(autoincrement())

  // Relations:
  // - The problem being attempted.
  problem   Problem @relation(fields: [problemId], references: [id])
  // - The user making the submission.
  user      User    @relation(fields: [userId], references: [id])
  problemId Int
  userId    Int

  // Submission details.
  code            String
  language        String
  status          SubmissionStatus
  runtime         Int
  memory          Int
  testCasesPassed Int
  totalTestCases  Int

  // Timestamps.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

// =========================================================
// SubmissionStatus Enum
// Represents the possible statuses of a submission.
// =========================================================

enum SubmissionStatus {
  accepted
  wrong_answer
  compilation_error
  time_limit_exceeded
  runtime_error
}

model SubmissionRuntime {
  id                    Int      @id @default(autoincrement())
  problem               Problem  @relation(fields: [problemId], references: [id])
  problemId             Int
  language              String // "cpp" | "java" | "python" | "javascript"
  runtimeInMilliseconds Int
  createdAt             DateTime @default(now())

  @@index([problemId, language])
}

model BaseCode {
  id            Int     @id @default(autoincrement())
  problem       Problem @relation(fields: [problemId], references: [id])
  problemId     Int
  language      String // e.g., "cpp", "javascript", "python", "java"
  baseClassCode String? // Store starter code template as a JSON object (key: language, value: code)
  headerFiles   String? // Store header files as a JSON object (key: language, value: header content)
  mainClassCode String? // Store main class code as a JSON object (key: language, value: main class code)

  // Ensure each problem-language combination is unique
  @@unique([problemId, language])
}

model UserProblemReactions {
  // Relations
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  problem   Problem @relation(fields: [problemId], references: [id])
  problemId Int

  // Reaction type
  reactionType ReactionType

  // Timestamp for when the reaction was created/updated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  // Compound primary key to ensure a user can only have one reaction per problem
  @@id([userId, problemId])
}

// =========================================================
// ReactionType Enum
// Represents the allowed reaction types
// =========================================================

enum ReactionType {
  like
  dislike
}

model UserLink {
  id        Int      @id @default(autoincrement())
  key       String?
  value     String?
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model Interview {
  id                Int           @id @default(autoincrement())
  userId            Int
  user              User          @relation(fields: [userId], references: [id])
  role              String
  type              InterviewType
  techStack         String[]
  level             String
  amount            Int
  questions         String[]
  feedback          Feedback[]
  finalized         Boolean       @default(false)
  feedbackFinalized Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt()
}

enum InterviewType {
  TECHNICAL
  BEHAVIORAL
  MIXED
}

// =========================================================
// Feedback Model
// Represents feedback for an interview
// =========================================================

model Feedback {
  id                  Int             @id @default(autoincrement())
  interviewId         Int
  interview           Interview       @relation(fields: [interviewId], references: [id])
  userId              Int
  user                User            @relation(fields: [userId], references: [id])
  totalScore          Float
  categoryScores      CategoryScore[]
  strengths           String[]
  areasForImprovement String[]
  finalAssessment     String
  finalVerdict        Verdict
  candidateTalkRatio  Float               @default(0)
  questionScores      QuestionScore[]
  keyMoments          KeyMoment[]
  recommendedTopics   RecommendedTopic[]
  createdAt           DateTime        @default(now())
}

model QuestionScore {
  id             Int      @id @default(autoincrement())
  feedback       Feedback @relation(fields: [feedbackId], references: [id])
  feedbackId     Int
  questionNumber Int
  questionText   String
  score          Float
  comment        String
}

model KeyMoment {
  id             Int           @id @default(autoincrement())
  feedback       Feedback      @relation(fields: [feedbackId], references: [id])
  feedbackId     Int
  type           KeyMomentType
  questionNumber Int
  questionText   String
  quote          String
  annotation     String
  timestampLabel String
}

model RecommendedTopic {
  id         Int           @id @default(autoincrement())
  feedback   Feedback      @relation(fields: [feedbackId], references: [id])
  feedbackId Int
  topic      String
  reason     String
  priority   TopicPriority
  tags       String[]
}

enum KeyMomentType {
  BEST
  WEAKEST
  NOTABLE
}

enum TopicPriority {
  CRITICAL
  IMPORTANT
  RECOMMENDED
}

enum Verdict {
  NOT_RECOMMENDED
  DO_NOT_HIRE
  PREFER_NOT_TO_HIRE
  WORTH_CONSIDERING
  RECOMMENDED
  MUST_HIRE
}

// =========================================================
// CategoryScore Model
// Represents individual category scores within feedback
// =========================================================

model CategoryScore {
  id         Int      @id @default(autoincrement())
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
  feedbackId Int
  name       String
  score      Float
  comment    String
}

model Comment {
  id        Int               @id @default(autoincrement())
  content   String
  authorId  Int
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    Int
  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  Int?
  parent    Comment?          @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentToComment")
  votes     CommentReaction[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  problem   Problem?          @relation(fields: [problemId], references: [id])
  problemId Int?

  @@index([postId, parentId, createdAt])
  @@index([parentId])
}

model CommentReaction {
  id        Int          @id @default(autoincrement())
  type      ReactionType
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId Int
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, commentId])
}

model Post {
  id            Int            @id @default(autoincrement())
  title         String
  authorId      Int
  author        User           @relation(fields: [authorId], references: [id])
  problemId     Int
  problem       Problem        @relation(fields: [problemId], references: [id])
  tags          PostTags[]
  comments      Comment[]
  postReactions PostReaction[]
  content       String
  isDraftPost   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PostTags {
  id        Int      @id @default(autoincrement())
  name      String
  PostId    Int
  Post      Post     @relation(fields: [PostId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostReaction {
  type      ReactionType
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  postId    Int
  post      Post         @relation(fields: [postId], references: [id])
  Problem   Problem?     @relation(fields: [problemId], references: [id])
  problemId Int?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@id([userId, postId])
}

// =========================================================
// Chat Model
// Represents a chat between user and AI
// =========================================================

model Chat {
  id String @id @default(cuid())

  // Relation: The user who owns this Chat
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  // Chat metadata
  title String @default("New Chat")

  // Relations
  messages Message[]

  // Persisted active path — ordered array of message IDs from root to current leaf.
  // Survives page refresh so the user's branch position is preserved.
  activePath String[] @default([])

  sourceShareId String?

  sourceChatId  String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, sourceShareId])
  @@index([userId, sourceChatId])
}

// =========================================================
// Message Model
// Represents individual messages in a Chat
// =========================================================

model Message {
  id String @id @default(cuid())

  // Relation: The Chat this message belongs to
  Chat   Chat   @relation(fields: [ChatId], references: [id], onDelete: Cascade)
  ChatId String

  // Message content
  text String @db.Text // Use Text type for longer messages

  // Message metadata
  role    MessageRole // 'user' or 'assistant'
  status  MessageStatus @default(sent)
  aiModel String?       @default("gpt-4")

  // Tree structure — self-referential parent/child.
  // parentId is null for root messages (the first user message in a chat).
  // Every other message's parent is the immediately preceding message.
  parentId String?
  parent   Message?  @relation("MessageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Message[] @relation("MessageTree")

  // User feedback on AI messages
  feedback MessageFeedback?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ChatId, createdAt]) // Index for efficient message queries
  @@index([ChatId, parentId]) // Critical for sibling queries
}

// =========================================================
// MessageRole Enum
// Represents who sent the message
// =========================================================

enum MessageRole {
  user
  assistant
}

// =========================================================
// MessageStatus Enum
// Represents the status of a message
// =========================================================

enum MessageStatus {
  sending
  thinking
  sent
  error
  aborted
}

enum MessageFeedback {
  LIKE
  DISLIKE
}

model RegenerateState {
  id              String   @id @default(cuid())
  chatId          String
  userMessageId   String   @unique // Track by USER message ID
  regenerateCount Int      @default(0)
  lastUsedModel   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([chatId, userMessageId])
}

model ProblemHelpState {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  problemId Int
  problem   Problem @relation(fields: [problemId], references: [id])

  solutionAttempts Int @default(0)
  maxHintLevel     Int @default(0)
  refusalLevel     Int @default(1)

  lastAskedAt DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([userId, problemId])
}

model StickyNote {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?  @default("Untitled Note")
  content   String   @default("")
  color     String   @default("yellow")
  x         Float    @default(100)
  y         Float    @default(100)
  width     Float    @default(320)
  height    Float    @default(240)
  zIndex    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SharedChat {
  id        String   @id @default(cuid())
  title     String
  messages  Json
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourceChatId String?
  expiresAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}
